<?xml version="1.0" encoding="utf-8"?>
<!--
  The NuGet configuration a restore is tried with first: the sources, taken away.

  A restore that reaches a feed which cannot be reached does not fail — it waits, and a gate that
  waits is a gate that hangs on a machine that is offline with everything it needs already cached.
  Every package a build wants is in the global packages folder once one restore has succeeded, so
  the run scripts restore with this configuration first and fall back to the feed only when
  something is genuinely missing — the one time waiting for it is worth it.

  It is deliberately not named `nuget.config`: a file with that name is found and read on its own,
  which would take the sources away from every restore rather than only from this one.
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
