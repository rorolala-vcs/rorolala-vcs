<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RorolalaDesktop.SysIcons</RootNamespace>
    <!-- The public surface is a contract, so every part of it is said in a comment and the
         documentation file is what a caller reads it from. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- What is handed back is a control's source, so the type is Avalonia's rather than this
         library's: a caller draws it, and this library has nothing to draw with. -->
    <PackageReference Include="Avalonia" Version="11.3.22" />
  </ItemGroup>

</Project>
