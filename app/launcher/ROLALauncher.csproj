<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- The name a person meets: the product's, not the namespace's. It is laid down beside the Desktop
         program, which is where `rola desktop` reaches and where this program reaches for it. -->
    <AssemblyName>ROLALauncher</AssemblyName>
    <RootNamespace>RorolalaLauncher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The program as a file: the icon a file list draws and a pinned program keeps. It is the same
         picture the Desktop program carries, because the two are one product to whoever pins either. -->
    <ApplicationIcon>../../res/icons/yizi.ico</ApplicationIcon>
    <AvaloniaIncludeApplicationIconAsWindowIcon
        >false</AvaloniaIncludeApplicationIconAsWindowIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.3" />
    <!-- The window draws its own frame, and on Wayland that is the client's job: the compositor is asked
         for none, and the toolkit draws the bar and the edges it would otherwise have taken. -->
    <PackageReference Include="Avalonia.Wayland" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
            Include="../desktop/Contract/RorolalaDesktop.Contract.csproj"
        />
    <ProjectReference
            Include="../../utils/desktop-i18n/RorolalaDesktopI18n.csproj"
        />
    <!-- The face every word is set in, embedded in the assembly the Desktop program also carries: the
         two programs are drawn with one font, and this one asks nobody's machine for it. -->
    <ProjectReference
            Include="../../utils/desktop-fonts/RorolalaDesktopFonts.csproj"
        />
  </ItemGroup>

  <ItemGroup>
    <!-- The theme file, the colours and the three window styles are the Desktop program's own
         statements, and they are shared rather than restated: the same sources are compiled here, so
         there is one reading of `theme.json` and one set of names in the product. A copy would be a
         second statement of the same file that could drift from the first. -->
    <Compile
            Include="../desktop/Core/Configuration/Configuration.cs"
            Link="Shared/Configuration.cs"
        />
    <Compile
            Include="../desktop/Core/Configuration/ConfigPaths.cs"
            Link="Shared/ConfigPaths.cs"
        />
  <Compile
            Include="../../modules/rola-sharp/UserDataPaths.cs"
            Link="Shared/UserDataPaths.cs"
        />
    <Compile
            Include="../desktop/Core/Configuration/ConfigurationLoader.cs"
            Link="Shared/ConfigurationLoader.cs"
        />
    <Compile
            Include="../desktop/Core/Configuration/ThemeFileWatch.cs"
            Link="Shared/ThemeFileWatch.cs"
        />
    <Compile
            Include="../desktop/Core/Configuration/Failure.cs"
            Link="Shared/Failure.cs"
        />
    <Compile
            Include="../desktop/Core/Theming/WindowStyle.cs"
            Link="Shared/WindowStyle.cs"
        />
    <!-- The mark that turns while something is waited for is the same mark in both programs: this window shows
         one over a Workspace whose window is being opened, and the Desktop program shows one over itself while
         it assembles. One drawing, then, rather than two that could turn differently. -->
    <Compile
            Include="../desktop/Core/Hosting/TurningMark.cs"
            Link="Shared/TurningMark.cs"
        />
  </ItemGroup>

  <ItemGroup>
    <!-- The launcher's own types are not part of what a plugin sees, so nothing outside reaches them but
         the integration suite that drives them. -->
    <InternalsVisibleTo Include="ROLALauncher.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The pictures this program is drawn with, embedded so that they travel in it: the four its own
         toolbar wears, which are drawn into `icons/` from the pinned Phosphor set by `cargo dev icons`, and
         the two marks a window's frame carries, which are the Desktop program's own files, the frames the
         two programs draw are one frame, so the marks on them are one set. The Desktop's are linked rather
         than copied, so the tree keeps one place a picture lives. -->
    <EmbeddedResource
            Include="icons/user-circle.png"
            LogicalName="RorolalaLauncher.icons.user-circle.png"
        />
    <EmbeddedResource
            Include="icons/plus-circle.png"
            LogicalName="RorolalaLauncher.icons.plus-circle.png"
        />
    <EmbeddedResource
            Include="icons/folder-open.png"
            LogicalName="RorolalaLauncher.icons.folder-open.png"
        />
    <EmbeddedResource
            Include="icons/translate.png"
            LogicalName="RorolalaLauncher.icons.translate.png"
        />
    <!-- The Git logomark a git-rola Workspace wears. It is a copy in this project's own icon area rather
         than a file of the Git plugin, because a plugin may not be installed and the launcher still has
         to open on a machine without it. -->
    <EmbeddedResource
            Include="icons/git.png"
            LogicalName="RorolalaLauncher.icons.git.png"
        />
    <EmbeddedResource
            Include="../desktop/Core/icons/x.png"
            Link="icons/x.png"
            LogicalName="RorolalaLauncher.icons.x.png"
        />
    <EmbeddedResource
            Include="../desktop/Core/icons/minus.png"
            Link="icons/minus.png"
            LogicalName="RorolalaLauncher.icons.minus.png"
        />
    <EmbeddedResource
            Include="../desktop/Core/icons/gear.png"
            Link="icons/gear.png"
            LogicalName="RorolalaLauncher.icons.gear.png"
        />
  </ItemGroup>

  <ItemGroup>
    <!-- What the launcher says is read from beside the program rather than built into it, following the
         Desktop program: the two are laid down in one directory, and what each states travels with it. -->
    <None Update="i18n/**/*.yml" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Git logomark's attribution, which the license under it asks a distribution to carry. -->
    <None Update="icons/GIT-LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- What a published layout is handed over without: debug symbols. The Desktop program states the same
       thing for the same reason, and this program is published into the same directory. -->
  <Target Name="NoDebugSymbols" AfterTargets="Publish">
    <ItemGroup>
      <PublishedSymbols Include="$(PublishDir)**/*.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishedSymbols)" />
  </Target>

</Project>
