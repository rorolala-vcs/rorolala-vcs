<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FileSystemPlugin</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Desktop host's suite, which starts this plugin against a scratch directory and reads the
         listing it staged: what is checked is which entries a listing leaves out, which is not visible
         from outside the plugin. -->
    <InternalsVisibleTo Include="RorolalaDesktopHost.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plugins build the UI out of Avalonia controls directly, which is the deliberate trade that
         keeps the contract small. The load context delegates Avalonia to the host's copy, so what
         is built here is inserted into the host's tree as the same kind of control. -->
    <PackageReference Include="Avalonia" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The contract is the only thing the host and a plugin agree on; the translations are read by
         the same reader the host uses, so what this plugin says is said the way the host says it; and
         the icons are the system's own, which is what a desktop expects a folder to be drawn with. -->
    <ProjectReference Include="../../Contract/RorolalaDesktop.Contract.csproj" />
    <ProjectReference Include="../../../../utils/desktop-i18n/RorolalaDesktopI18n.csproj" />
    <ProjectReference Include="../../../../utils/desktop-sys-icons/RorolalaDesktopSysIcons.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The plugin's own words, laid beside its assembly so that what it registers is found the
         moment the host starts it. -->
    <None Update="i18n/**/*.yml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The pictures this plugin contributes to the icon library, embedded so that they travel in the
         one file the host lays beside the program: a plugin is discovered as an assembly, and a
         picture read from beside it would be a second thing to keep in step with it. What is drawn is
         `./run.sh icons`, from the manifest in `app/desktop/icons.toml`; the LICENSE and README.md
         beside them are that run's too, and say where the artwork came from. -->
    <EmbeddedResource Include="icons/*.png" />
  </ItemGroup>

</Project>
