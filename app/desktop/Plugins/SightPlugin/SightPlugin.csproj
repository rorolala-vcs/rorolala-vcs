<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SightPlugin</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The integration suite drives the previewer list and the metadata providers, which are not
         visible from outside the plugin. -->
    <InternalsVisibleTo Include="RorolalaDesktopHost.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- As every plugin builds its UI: against the host's own Avalonia copy, which the load context
         delegates to. -->
    <PackageReference Include="Avalonia" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The contract is the only thing the host and a plugin agree on; the translations are read by
         the same reader the host uses; the File System plugin is what this one follows, and its
         manifest names the same plugin in its dependencies. Only this plugin's own assembly is laid
         beside the program, so the File System plugin's is the copy the load context hands over. -->
    <ProjectReference Include="../../Contract/RorolalaDesktop.Contract.csproj" />
    <ProjectReference Include="../../../../utils/desktop-i18n/RorolalaDesktopI18n.csproj" />
    <ProjectReference Include="../FileSystemPlugin/FileSystemPlugin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The plugin's own words, laid beside its assembly so that what it registers is found the
         moment the host starts it. -->
    <None Update="i18n/**/*.yml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The pictures this plugin contributes to the icon library, embedded so that they travel in the
         one file the host lays beside the program. What is drawn is `cargo dev icons`, from the
         manifest in `app/desktop/icons.toml`. -->
    <EmbeddedResource Include="icons/*.png" />
  </ItemGroup>

</Project>
