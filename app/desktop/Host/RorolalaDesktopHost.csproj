<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.3" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The face the Desktop window is drawn in, so that the report this host shows over a failed run
         is set in the same face as the program it is reporting on. -->
    <ProjectReference Include="../../../utils/desktop-fonts/RorolalaDesktopFonts.csproj" />
  </ItemGroup>
</Project>
