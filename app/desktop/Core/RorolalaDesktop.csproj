<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The program as a file: the icon a file list draws and a pinned program keeps. The same
         picture is embedded again below as the one the windows are drawn with, and the two are not
         the same thing — one is a program to a file manager, the other a program to a window. -->
    <ApplicationIcon>../../../res/icons/yizi.ico</ApplicationIcon>
    <!-- The window icon is put on the windows this host makes, in `AppIcon`, rather than left to the
         default Avalonia would take from `ApplicationIcon`: that default embeds the file a second
         time under a name of its own and dresses every window, including the ones plugins make,
         which is a choice this host makes explicitly instead. -->
    <AvaloniaIncludeApplicationIconAsWindowIcon>false</AvaloniaIncludeApplicationIconAsWindowIcon>
    <!-- The window is always made by the host and handed its services, so it is deliberately not
         reachable through Avalonia's runtime XAML loader, which wants a public parameterless
         constructor; that loader is never used for it. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The pictures the window's own buttons are drawn as, embedded so that they travel in the program
         itself and not beside it: the program is what they belong to, and a picture in a directory is one
         more thing that can be left behind by a copy of it. They are drawn from the pinned Material Design
         set by `cargo dev icons`, and the keys they are read by are generated from the same manifest. -->
    <EmbeddedResource Include="icons/*.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.3" />
    <!-- The window draws its own frame, and on Wayland that is the client's job: the compositor is asked
         for none, and the toolkit draws the bar and the edges it would otherwise have taken. The backend
         is the one Linux talks Wayland with; `Avalonia.Desktop` reaches for X11 and nothing else. -->
    <PackageReference Include="Avalonia.Wayland" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The host's own types are not part of the contract, so nothing outside sees them but the
         integration suite that drives the host directly. -->
    <InternalsVisibleTo Include="RorolalaDesktopHost.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- What the window says is read from beside the program rather than built into it, following
         the command line, which reads its own from the same shape of file. The glob is updated
         rather than added to: the files are already items, and one item of one name is one item. -->
    <None Update="i18n/**/*.yml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The picture the windows are drawn with, embedded rather than read from beside the program,
         unlike the words above: what a program looks like is part of what it is, and an icon read
         from beside it is one that a copy moved by hand can lose. `Link` is the path it answers to
         inside the assembly, which `AppIcon` names; the file itself is linked rather than copied
         into this tree, so `res/icons` stays the one place an icon lives. -->
    <AvaloniaResource Include="../../../res/icons/yizi.ico" Link="res/icons/yizi.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The host compiles against the same contract its plugins do, so the two agree by
         construction rather than by being kept in step by hand. The contract sits beside the core
         rather than inside it: it is the boundary between the host and its plugins, not a part of
         either. -->
    <ProjectReference Include="../Contract/RorolalaDesktop.Contract.csproj" />
    <ProjectReference Include="../../../utils/desktop-i18n/RorolalaDesktopI18n.csproj" />
    <!-- Carried rather than used. A plugin's dependencies are what the host itself carries, since
         nothing but a plugin's own assembly is laid beside it; the icons are one of them, so the
         host has to have them for a plugin to be allowed to ask for them. -->
    <ProjectReference Include="../../../utils/desktop-sys-icons/RorolalaDesktopSysIcons.csproj" />
  </ItemGroup>

  <!--
    What a published layout is handed over without: debug symbols.

    The drawing and text-shaping libraries travel in their packages with their symbols beside them —
    SkiaSharp's alone is eighty megabytes — and the SDK copies what a package holds, with no property
    that says otherwise: `CopyDebugSymbolFilesFromPackages` is about symbol *packages*, not about what
    an ordinary package keeps in its `native` directory. So they are taken away after the publish,
    which is the one place where that can be said.

    Ours go with them, and deliberately: `dotnet build` writes them into the build tree, which is where
    a program being debugged is run from, and what this layout is for is a program to hand over. A
    layout carrying one set and not the other would be a layout whose reader has to wonder which they
    have.
  -->
  <Target Name="NoDebugSymbols" AfterTargets="Publish">
    <ItemGroup>
      <PublishedSymbols Include="$(PublishDir)**/*.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishedSymbols)" />
  </Target>

</Project>
