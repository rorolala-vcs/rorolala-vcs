#include <windows.h>
#include "resource.h"

/* One manifest resource: COMCTL32 v6 for the Windows 10 control theme. */
1 RT_MANIFEST "app.manifest"

IDD_MAIN DIALOGEX 0, 0, 420, 300
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_CLIPCHILDREN
CAPTION "Rorolala Daemon"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    CONTROL "", IDC_TABS, "SysTabControl32", WS_TABSTOP | WS_CLIPSIBLINGS, 7, 7, 406, 264
    LTEXT "", IDC_MAIN_STATUS, 7, 280, 406, 10, SS_ENDELLIPSIS
END

IDD_DAEMON DIALOGEX 0, 0, 398, 238
STYLE DS_SETFONT | WS_CHILD | WS_CLIPSIBLINGS
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT "Port", -1, 8, 10, 26, 10
    EDITTEXT IDC_DAEMON_PORT, 34, 8, 42, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "(1-65535; blank uses 7717 or ROLA_DEFAULT_PORT)", -1, 82, 10, 310, 10
    PUSHBUTTON "Start", IDC_DAEMON_START, 34, 30, 60, 18, BS_DEFPUSHBUTTON
    PUSHBUTTON "Stop", IDC_DAEMON_STOP, 100, 30, 60, 18
    LTEXT "Stopped", IDC_DAEMON_STATUS, 168, 34, 224, 10, SS_ENDELLIPSIS
    LTEXT "Output", -1, 8, 58, 40, 10
    EDITTEXT IDC_DAEMON_LOG, 8, 68, 384, 164, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
END

IDD_REGISTRY DIALOGEX 0, 0, 398, 238
STYLE DS_SETFONT | WS_CHILD | WS_CLIPSIBLINGS
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LISTBOX IDC_REG_LIST, 8, 8, 282, 184, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "New", IDC_REG_NEW, 296, 8, 94, 16
    PUSHBUTTON "Edit", IDC_REG_EDIT, 296, 28, 94, 16
    PUSHBUTTON "Delete", IDC_REG_DELETE, 296, 48, 94, 16
    PUSHBUTTON "Browse...", IDC_REG_BROWSE, 296, 68, 94, 16
    PUSHBUTTON "Edit text...", IDC_REG_EDITTEXT, 296, 88, 94, 16
    PUSHBUTTON "Refresh", IDC_REG_REFRESH, 296, 112, 94, 16
    PUSHBUTTON "Check", IDC_REG_CHECK, 296, 132, 94, 16
    EDITTEXT IDC_REG_PATH, 8, 200, 282, 14, ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP
    LTEXT "The table is sorted by namespace; Move Up/Down has no meaning here.", IDC_REG_NOTE, 8, 220, 382, 10, SS_ENDELLIPSIS
END

IDD_KEYS DIALOGEX 0, 0, 398, 238
STYLE DS_SETFONT | WS_CHILD | WS_CLIPSIBLINGS
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LISTBOX IDC_KEY_LIST, 8, 8, 382, 186, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Import Keys...", IDC_KEY_IMPORT, 8, 202, 90, 16
    PUSHBUTTON "Refresh", IDC_KEY_REFRESH, 104, 202, 60, 16
    PUSHBUTTON "Open folder", IDC_KEY_OPEN, 170, 202, 74, 16
    LTEXT "", IDC_KEY_DIR, 8, 222, 382, 10, SS_ENDELLIPSIS
END

IDD_ADMINS DIALOGEX 0, 0, 398, 238
STYLE DS_SETFONT | WS_CHILD | WS_CLIPSIBLINGS
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT "Vault", -1, 8, 10, 30, 10
    COMBOBOX IDC_ADMIN_VAULT, 40, 8, 244, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Refresh", IDC_ADMIN_REFRESH, 296, 7, 94, 16
    LISTBOX IDC_ADMIN_LIST, 8, 28, 282, 186, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Add...", IDC_ADMIN_ADD, 296, 28, 94, 16
    PUSHBUTTON "Remove", IDC_ADMIN_REMOVE, 296, 48, 94, 16
    PUSHBUTTON "Edit vault.toml...", IDC_ADMIN_EDIT, 296, 72, 94, 16
    LTEXT "Administrators may move any file in the Vault's layout.", IDC_ADMIN_NOTE, 8, 222, 382, 10, SS_ENDELLIPSIS
END

IDD_ENTRY DIALOGEX 0, 0, 260, 74
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Registry Entry"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT "Namespace", -1, 8, 12, 50, 10
    EDITTEXT IDC_ENTRY_NS, 62, 10, 190, 14, ES_AUTOHSCROLL
    LTEXT "Vault path", -1, 8, 34, 50, 10
    EDITTEXT IDC_ENTRY_PATH, 62, 32, 150, 14, ES_AUTOHSCROLL
    PUSHBUTTON "Browse...", IDC_ENTRY_BROWSE, 216, 31, 36, 16
    DEFPUSHBUTTON "OK", IDOK, 144, 52, 50, 16
    PUSHBUTTON "Cancel", IDCANCEL, 200, 52, 52, 16
END

IDD_NAME DIALOGEX 0, 0, 240, 62
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add Administrator"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT "Member name", -1, 8, 14, 62, 10
    COMBOBOX IDC_NAME_COMBO, 72, 12, 160, 120, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 124, 38, 50, 16
    PUSHBUTTON "Cancel", IDCANCEL, 180, 38, 52, 16
END
