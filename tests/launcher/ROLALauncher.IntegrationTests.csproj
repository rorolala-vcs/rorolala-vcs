<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The name the launcher exposes its internals to; it is also the assembly name. -->
    <AssemblyName>ROLALauncher.IntegrationTests</AssemblyName>
    <RootNamespace>RolalalaLauncher.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- The toolkit, because the launcher is made of it: what is checked here is the reading a window is
         built from rather than a window, and a reading of the toolkit's types still needs the toolkit. -->
    <PackageReference Include="Avalonia" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The launcher itself: this suite drives its own types — the file it keeps, the picture it plays,
         the addresses it reads — rather than only the program a person runs. -->
    <ProjectReference Include="../../app/launcher/ROLALauncher.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The banner the program ships with, so that what is checked is the file a user meets rather than a
         file written for the test. -->
    <None Include="../../res/desktop-launcher-banner/red-flash.aseprite" Link="red-flash.aseprite" CopyToOutputDirectory="PreserveNewest" />
    <!-- The other picture the program ships, whose frames after the first reach their bottom layer through a
         linked cel: it is what checks that a link is drawn as the cel it names. -->
    <None Include="../../res/desktop-launcher-banner/rola-command.aseprite" Link="rola-command.aseprite" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
