<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The name the host exposes its internals to; it is also the assembly name. -->
    <AssemblyName>RorolalaDesktopHost.IntegrationTests</AssemblyName>
    <RootNamespace>RorolalaDesktopHost.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Avalonia" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The host itself. This suite drives its own types — the configuration, the plugin manager,
         the registries, the log — rather than only the contract it publishes. -->
    <ProjectReference Include="../../app/desktop/Core/RorolalaDesktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The fixture plugins are built with this suite and laid out beside it, so the assemblies the
         host loads are real ones rather than stand-ins for the contract. -->
    <PluginProject Include="../desktop-plugins/*/*.csproj" />
    <ProjectReference Include="@(PluginProject)" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CollectPluginAssemblies" DependsOnTargets="ResolveProjectReferences">
    <MSBuild
      Projects="@(PluginProject)"
      Targets="GetTargetPath"
      Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="PluginAssembly" />
    </MSBuild>
  </Target>

  <Target Name="CopyPluginAssemblies" AfterTargets="Build" DependsOnTargets="CollectPluginAssemblies">
    <Copy
      SourceFiles="@(PluginAssembly)"
      DestinationFolder="$(OutDir)plugins"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
