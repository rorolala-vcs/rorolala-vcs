<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RolaSharp</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    The bindings are generated by the target below and are a compile item like any other — written
    beside this file, so the project lists it and an IDE reads it as it reads the hand-written sources.
    It is checked in, so an IDE has it without having built, and the build rewrites it from the header;
    the generator is deterministic, so rewriting it is no change.

    Debug and release read the header of their own profile, so one profile's bindings are never
    compiled against the other's library — the header is kept apart by profile for the same reason.
  -->
  <PropertyGroup>
    <RsharpProfile Condition="'$(Configuration)' == 'Debug'">debug</RsharpProfile>
    <RsharpProfile Condition="'$(RsharpProfile)' == ''">release</RsharpProfile>
    <RsharpRoot>$(MSBuildThisFileDirectory)../../</RsharpRoot>
    <RsharpHeader>$(RsharpRoot).cache/rs-target/$(RsharpProfile)/ffi_bindings/rorolala_ffi.h</RsharpHeader>
    <RsharpBinding>$(MSBuildThisFileDirectory)RorolalaBinding.cs</RsharpBinding>
  </PropertyGroup>

  <!--
    Every build regenerates the bindings from the header, so they are never stale against it. The
    header is the Rust side's output, which is why the Rust side has to have been built first; a build
    of this project alone, before any Rust build, has nothing to read.

    Not run for a design-time build: an IDE puts the project questions many times as a person types,
    and cargo is not a question. The file is checked in, so the IDE reads the last one written.
  -->
  <Target
    Name="GenerateRorolalaBinding"
    BeforeTargets="BeforeBuild"
    Condition="'$(DesignTimeBuild)' != 'true'">
    <Error
      Condition="!Exists('$(RsharpHeader)')"
      Text="the C header is not there: `$(RsharpHeader)`. Build Rust first, with `./run.sh build`." />
    <Exec
      Command="cargo run --quiet --manifest-path &quot;$(RsharpRoot)Cargo.toml&quot; -p rorolala-dev-rsharp-bindgen -- &quot;$(RsharpHeader)&quot; &quot;$(RsharpBinding)&quot;" />
  </Target>

</Project>
